# Local development defaults. Copy to .env before `docker compose up`.
# These values are for a private workstation. Do not reuse them in a shared environment.

POSTGRES_USER=vi
POSTGRES_PASSWORD=vi
POSTGRES_DB=volleyball_intelligence
# Host port. 5432 is often taken by a local PostgreSQL install.
POSTGRES_PORT=5433

# Used by tools on the host. Compose overrides the API URL to hostname `db`.
DATABASE_URL=postgresql+psycopg://vi:vi@localhost:5433/volleyball_intelligence

API_PORT=8000
WEB_PORT=3000
# Browser calls Next.js. Next.js calls this URL from the server.
# Local `npm run dev`: http://localhost:8000
# Docker Compose sets http://api:8000 for the web service.
API_INTERNAL_URL=http://localhost:8000

APP_ENV=development
CORS_ORIGINS=http://localhost:3000
